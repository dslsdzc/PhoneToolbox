<RCC>
    <qresource prefix="/binaries">
        <!-- MTK Bridge (not available elsewhere, keep embedded) -->
        <file alias="mtk_bridge/linux/x64/mtk_bridge">../third_party/mtk_bridge/linux/x64/mtk_bridge</file>
    </qresource>
    <!-- 使用须知正文（W2 Task 3）：**单一副本** —— spec §2 的代码块逐字搬来，正文不得改写。
         alias 是必须的：前缀 /legal + 无 alias 会得到 :/legal/legal/user-agreement.md。
         用例三路比对（spec 正文 ↔ 本文件 ↔ legal::kAgreementVersion）。 -->
    <qresource prefix="/legal">
        <file alias="user-agreement.md">legal/user-agreement.md</file>
    </qresource>
    <!-- W8-T6：利用载荷来源清单的**内置副本**（用户没在自己配置路径放清单时的兜底）。
         ⚠️ 它**只有 URL + sha256**，不含任何载荷二进制（本仓不分发载荷，见 mtk_brom_exploit.h）。
         与磁盘上那份是同一份文件的两个入口：用户配置优先（bromui::defaultSourceListPath）。 -->
    <qresource prefix="/exploit">
        <file alias="exploit-payload-sources.json">exploit-payload-sources.json</file>
    </qresource>
    <!-- 漏洞应用的 Lua 界面脚本（BROM 是第一个完全由 HTML + Lua 描述的例子）。 -->
    <qresource prefix="/ui">
        <file alias="brom_exploit.lua">brom_exploit.lua</file>
    </qresource>
</RCC>
