build/
build-windows/
dist-windows/
*.zip
# 用户自定义漏洞数据库，不纳入版本控制
vulndb.json


reference/

# 构建目录（含 build-h1/ build-release/ build-final-fw/ build-windows/ 等历史/临时目录）
build*/
# 工具脚本（tools/*.py）被 import 时留下的字节码缓存；reference/ 下的同理（整目录已忽略）
__pycache__/

# Android root agent build artifacts / signing material
android/root-agent/.gradle/
android/root-agent/local.properties
android/root-agent/*.jks
android/root-agent/.jks-pass
android/root-agent/app/src/main/jniLibs/


# Downloaded/compiled helper tools (apktool.jar, AOT binaries, aapt2, etc.)
tools/vendor/

# Signing material / APK outputs
*.jks
*.jks-pass
*.keystore
*.apk

# Logs / crash dumps
*.log
/core
core.*
.PhoneToolbox.*
